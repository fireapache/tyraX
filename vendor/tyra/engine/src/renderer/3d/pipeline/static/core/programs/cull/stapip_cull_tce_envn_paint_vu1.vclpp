;---------------------------------------------------------------
;
; Generated by TyraX (src/vugen.cpp). Do not edit - regenerate from
; the C++ description with: tyrax-editor --vu-emit <dir>
;
; StaPip - Cull - TCE
; Cull = the standard PS2 path: object-space vertices in, the MVP
; multiply and the ADC frustum test on VU1.
;
; Compact input (docs/compact-vertex-format.md): the VIF lands each
; attribute as 32-bit integer lanes - a position's grid index, a 4.12
; ST, a u8 colour, an int8 x 127 normal - and the program converts it
; with one itof right after its load.
; A colour no light touches is not converted: its u8 lanes reach
; the GS as they land.

.syntax new
.name StaPipVU1Cull_TCE_ENVN_PAINT
.vu
.init_vf_all
.init_vi_all

--enter
--endenter

#vuprog StaPipVU1CullTCEENVNPaint

    fcset      0x000000  ; ResetClipFlags
    lq         gifSetTag, 19(vi00)  ; VU1_SET_GIFTAG_ADDR
    lq         mvp[0], 0(vi00)  ; MatrixLoad - VU1_MVP_MATRIX_ADDR
    lq         mvp[1], 1(vi00)
    lq         mvp[2], 2(vi00)
    lq         mvp[3], 3(vi00)
    ilw.x      singleColorEnabled, 8(vi00)  ; VU1_OPTIONS_ADDR.x = single colour flag
    lq         lodGifTag, 9(vi00)  ; VU1_LOD_ADDR
    lq         testsTag, 10(vi00)  ; VU1_Z_TESTS_ADDR
    lq         texBufferClutGifTag, 11(vi00)  ; VU1_CLUT_ADDR
    lq         alphaGifTag, 21(vi00)  ; VU1_ALPHA_ADDR - per-mesh GS blend equation, in-band
    lq         fogParams, 8(vi00)  ; VU1_OPTIONS_ADDR.zw = GS hardware fog
    add.x      fogParams, vf00, fogParams[z]  ; fog scale into .x (CalculateTyraFog)
    iaddiu     adcMask, vi00, 16384  ; MakeTyraAdcMask: 0x8000 in two 15-bit adds
    iadd       adcMask, adcMask, adcMask
    lq         envBasisX, 4(vi00)  ; LoadTyraEnvBasis - VU1_ENV_BASIS_ADDR (the lights matrix area; env bags carry no lighting)
    lq         envBasisY, 5(vi00)
    lq         envBasisZ, 6(vi00)
begin:
    xtop       buffer
    ilw.y      paintMode, 8(vi00)  ; Private paint prepass. Accepted basis in 12/13; ABI unchanged.
    iaddiu     paintTwo, vi00, 2
    ibne       paintMode, paintTwo, paintDone
    ilw.w      paintCount, 0(buffer)
    iaddiu     paintMask, vi00, 1023
    iand       paintCount, paintCount, paintMask
    iblez      paintCount, paintDone
    iaddiu     paintNormal, buffer, 2
    iadd       paintNormal, paintNormal, paintCount
    iadd       paintColor, paintNormal, paintCount
    lq         paintFwd, 12(vi00)
    lq         paintHalf, 13(vi00)
paintLoop:
    lq         paintN, 0(paintNormal)
    itof0.xyz  paintN, paintN
    mul.xyz    paintTmp, paintN, paintFwd
    add.x      paintD, paintTmp, paintTmp[y]
    add.x      paintD, paintD, paintTmp[z]
    abs.x      paintD, paintD
    sub.x      paintD, vf00, paintD
    add.x      paintD, paintD, vf00[w]
    loi        0.699999988
    mul.x      paintD, paintD, i
    loi        0.300000012
    add.x      paintD, paintD, i
    loi        128
    mul.x      paintD, paintD, i
    add.xyz    paintOut, vf00, paintD[x]
    mul.xyz    paintTmp, paintN, paintHalf
    add.x      paintD, paintTmp, paintTmp[y]
    add.x      paintD, paintD, paintTmp[z]
    max.x      paintD, paintD, vf00[x]
    mul.x      paintD, paintD, paintD
    mul.x      paintD, paintD, paintD
    mul.x      paintD, paintD, paintD
    loi        220
    mul.x      paintD, paintD, i
    add.x      paintD, paintD, vf00[w]
    loi        255
    mini.x     paintD, paintD, i
    sub.w      paintOut, vf00, vf00[w]
    add.w      paintOut, paintOut, paintD[x]
    ftoi0      paintOut, paintOut
    sq         paintOut, 0(paintColor)
    iaddiu     paintNormal, paintNormal, 1
    iaddiu     paintColor, paintColor, 1
    iaddi      paintCount, paintCount, -1
    ibgtz      paintCount, paintLoop
paintDone:
    lq.xyz     scale, 0(buffer)  ; LoadTyraBufferTags
    lq         primTag, 1(buffer)
    iaddiu     vertexData, buffer, 2  ; VU1_STAPIP_VERT_DATA_ADDR
    ilw.w      vertexCount, 0(buffer)
    iadd       stqData, vertexData, vertexCount
    iadd       colorData, stqData, vertexCount
    iblez      singleColorEnabled, setDestAddrMultiColor
    iadd       kickAddress, stqData, vertexCount
    lq         singleColor, 7(vi00)  ; VU1_SINGLE_COLOR_ADDR - replicated for a stride-0 loop
    sq         singleColor, 1016(vi00)
    sq         singleColor, 1017(vi00)
    sq         singleColor, 1018(vi00)
    iaddiu     colorData, vi00, 1016
    iaddiu     colorStride, vi00, 0
    b          setDestAddr
setDestAddrMultiColor:
    iadd       kickAddress, colorData, vertexCount
    iaddiu     colorStride, vi00, 3
setDestAddr:
    iaddiu     destAddress, kickAddress, 0
    sq         gifSetTag, 0(destAddress)  ; GIF tag block
    sq         testsTag, 1(destAddress)
    sq         gifSetTag, 2(destAddress)
    sq         lodGifTag, 3(destAddress)
    sq         gifSetTag, 4(destAddress)
    sq         texBufferClutGifTag, 5(destAddress)
    sq         gifSetTag, 6(destAddress)
    sq         alphaGifTag, 7(destAddress)
    sq         primTag, 8(destAddress)
    iaddiu     destAddress, destAddress, 9
    iadd       vertexCounter, buffer, vertexCount
vertexLoop:
    lq         color1, 0(colorData)
    lq         color2, 1(colorData)
    lq         color3, 2(colorData)
    lq         vertex1, 0(vertexData)  ; W carries the clip-space distance (fog)
    lq         stq1, 0(stqData)
    itof0.xyz  vertex1, vertex1  ; compact: the grid index
    itof0.xyz  stq1, stq1
    lq         vertex2, 1(vertexData)
    lq         stq2, 1(stqData)
    itof0.xyz  vertex2, vertex2  ; compact: the grid index
    itof0.xyz  stq2, stq2
    lq         vertex3, 2(vertexData)
    lq         stq3, 2(stqData)
    itof0.xyz  vertex3, vertex3  ; compact: the grid index
    itof0.xyz  stq3, stq3
    mula.xy    acc, envBasisX, stq1[x]  ; CalculateTyraEnvStqUnit: the EE normalised it
    madda.xy   acc, envBasisY, stq1[y]
    madd.xy    stq1, envBasisZ, stq1[z]
    add.xy     stq1, stq1, envBasisZ[w]
    add.z      stq1, vf00, envBasisZ[z]
    mula       acc, mvp[0], vertex1[x]  ; MatrixMultiplyVertex
    madda      acc, mvp[1], vertex1[y]
    madda      acc, mvp[2], vertex1[z]
    madd       vertex1, mvp[3], vertex1[w]
    mul.x      fogAccum, fogParams, vertex1[w]  ; CalculateTyraFog
    add.x      fogAccum, fogAccum, fogParams[w]
    loi        255
    mini.x     fogAccum, fogAccum, i
    max.x      fogAccum, fogAccum, vf00[x]
    ftoi4.x    fogAccum, fogAccum
    mtir       fogInt, fogAccum[x]
    clipw.xyz  vertex1, vertex1  ; PerformTyraFogClipCheck
    fcand      VI01, 0x3FFFF
    iaddiu     adcBit, VI01, 32767
    iand       adcBit, adcBit, adcMask
    ior        adcBit, adcBit, fogInt
    isw.w      adcBit, 2(destAddress)
    div        q, vf00[w], vertex1[w]  ; VertexPersCorr
    mul.xyz    vertex1, vertex1, q
    mula.xyz   acc, scale, vf00[w]  ; ScaleVertexToGSFormat
    madd.xyz   vertex1, vertex1, scale
    ftoi4.xyz  vertex1, vertex1
    mul        outputStq1, stq1, q  ; PerformTexturePerspectiveCorrection
    mula.xy    acc, envBasisX, stq2[x]  ; CalculateTyraEnvStqUnit: the EE normalised it
    madda.xy   acc, envBasisY, stq2[y]
    madd.xy    stq2, envBasisZ, stq2[z]
    add.xy     stq2, stq2, envBasisZ[w]
    add.z      stq2, vf00, envBasisZ[z]
    mula       acc, mvp[0], vertex2[x]  ; MatrixMultiplyVertex
    madda      acc, mvp[1], vertex2[y]
    madda      acc, mvp[2], vertex2[z]
    madd       vertex2, mvp[3], vertex2[w]
    mul.x      fogAccum, fogParams, vertex2[w]  ; CalculateTyraFog
    add.x      fogAccum, fogAccum, fogParams[w]
    loi        255
    mini.x     fogAccum, fogAccum, i
    max.x      fogAccum, fogAccum, vf00[x]
    ftoi4.x    fogAccum, fogAccum
    mtir       fogInt, fogAccum[x]
    clipw.xyz  vertex2, vertex2  ; PerformTyraFogClipCheck
    fcand      VI01, 0x3FFFF
    iaddiu     adcBit, VI01, 32767
    iand       adcBit, adcBit, adcMask
    ior        adcBit, adcBit, fogInt
    isw.w      adcBit, 5(destAddress)
    div        q, vf00[w], vertex2[w]  ; VertexPersCorr
    mul.xyz    vertex2, vertex2, q
    mula.xyz   acc, scale, vf00[w]  ; ScaleVertexToGSFormat
    madd.xyz   vertex2, vertex2, scale
    ftoi4.xyz  vertex2, vertex2
    mul        outputStq2, stq2, q  ; PerformTexturePerspectiveCorrection
    mula.xy    acc, envBasisX, stq3[x]  ; CalculateTyraEnvStqUnit: the EE normalised it
    madda.xy   acc, envBasisY, stq3[y]
    madd.xy    stq3, envBasisZ, stq3[z]
    add.xy     stq3, stq3, envBasisZ[w]
    add.z      stq3, vf00, envBasisZ[z]
    mula       acc, mvp[0], vertex3[x]  ; MatrixMultiplyVertex
    madda      acc, mvp[1], vertex3[y]
    madda      acc, mvp[2], vertex3[z]
    madd       vertex3, mvp[3], vertex3[w]
    mul.x      fogAccum, fogParams, vertex3[w]  ; CalculateTyraFog
    add.x      fogAccum, fogAccum, fogParams[w]
    loi        255
    mini.x     fogAccum, fogAccum, i
    max.x      fogAccum, fogAccum, vf00[x]
    ftoi4.x    fogAccum, fogAccum
    mtir       fogInt, fogAccum[x]
    clipw.xyz  vertex3, vertex3  ; PerformTyraFogClipCheck
    fcand      VI01, 0x3FFFF
    iaddiu     adcBit, VI01, 32767
    iand       adcBit, adcBit, adcMask
    ior        adcBit, adcBit, fogInt
    isw.w      adcBit, 8(destAddress)
    div        q, vf00[w], vertex3[w]  ; VertexPersCorr
    mul.xyz    vertex3, vertex3, q
    mula.xyz   acc, scale, vf00[w]  ; ScaleVertexToGSFormat
    madd.xyz   vertex3, vertex3, scale
    ftoi4.xyz  vertex3, vertex3
    mul        outputStq3, stq3, q  ; PerformTexturePerspectiveCorrection
    sq         outputStq1, 0(destAddress)
    sq         color1, 1(destAddress)
    sq.xyz     vertex1, 2(destAddress)
    sq         outputStq2, 3(destAddress)
    sq         color2, 4(destAddress)
    sq.xyz     vertex2, 5(destAddress)
    sq         outputStq3, 6(destAddress)
    sq         color3, 7(destAddress)
    sq.xyz     vertex3, 8(destAddress)
    iaddiu     vertexData, vertexData, 3
    iaddiu     stqData, stqData, 3
    iadd       colorData, colorData, colorStride
    iaddiu     destAddress, destAddress, 9
    iaddi      vertexCounter, vertexCounter, -3  ; decrement the loop counter
    ibne       vertexCounter, buffer, vertexLoop
    xgkick     kickAddress  ; dispatch to the GS rasterizer

--barrier
--cont

    b          begin

#endvuprog

--exit
--endexit
